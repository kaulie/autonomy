#!/usr/bin/env bash
# git credential helper: walk up from cwd for .autonomy/github-token.
# Usage: git config --global credential.https://github.com.helper \
#   /path/to/runtime/autonomy/scripts/git-credential-autonomy
set -euo pipefail
if [ "${1:-}" != "get" ]; then
  exit 0
fi
dir=$(pwd)
for _ in $(seq 1 24); do
  f="${dir}/.autonomy/github-token"
  if [ -f "$f" ]; then
    token=$(tr -d '\n' < "$f")
    printf 'username=x-access-token\npassword=%s\n' "$token"
    exit 0
  fi
  parent=$(dirname "$dir")
  [ "$parent" = "$dir" ] && break
  dir=$parent
done
exit 0
